#!/bin/sh
# Regenerate VERSION after each commit and amend it into that same commit.
# One-time setup: ./scripts/setup-hooks.sh   (or setup-hooks.bat on Windows)
set -e
cd "$(git rev-parse --show-toplevel)"

if [ "$GIT_AMEND_VERSION" = "1" ]; then
  exit 0
fi

python3 git_rev.py --write-files 2>/dev/null || python git_rev.py --write-files

if git diff --quiet -- VERSION; then
  exit 0
fi

git add VERSION
GIT_AMEND_VERSION=1 git commit --amend --no-edit
